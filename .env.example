# YouTrack project id
YOUTRACK_PROJECT_CODE = ""

# Magento root, used by check:cron
MAGENTO_ROOT = "/data/web/magento2/current"

# Magento DB name, used by check:cron-job-execution (credentials are read from ~/.my.cnf)
DB_NAME = ""

# Notifier used by "--notify": slack (default) or sentry
NOTIFIER = "slack"

# Slack notifier: incoming webhook URL of the channel
SLACK_WEBHOOK_URL = ""

# Sentry notifier
SENTRY_DSN = ""

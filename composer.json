{
    "name": "taurus-media/server-monitor",
    "description": "Server Monitor facilitates an easy of use scripts for the purpose of monitoring VPSs. Each script available can be triggered periodically on the target VPS. Each individual script is designed to work on any VPS that has PHP available.",
    "type": "project",
    "license": "Proprietary",
    "autoload": {
        "psr-4": {
            "ServerMonitor\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "sentry/sentry": "^4.10",
        "vlucas/phpdotenv": "^5.6",
        "symfony/console": "^7.4",
        "symfony/finder": "^7.4"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        }
    },
    "require-dev": {
        "roave/security-advisories": "dev-latest",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1"
    }
}
